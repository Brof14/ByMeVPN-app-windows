{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "v2rust",
  "version": "0.1.0",
  "identifier": "com.rimuru.v2rust",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "v2rust",
        "width": 360,
        "height": 540,
        "resizable": false,
        "decorations": true,
        "maximizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "target/debug/xray/",
      "target/debug/xui.exe"
    ]
  }
}

