{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ByMeVPN",
  "version": "1.2.0",
  "identifier": "space.parahin.bymevpn.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ByMeVPN",
        "width": 1320,
        "height": 850,
        "minWidth": 900,
        "minHeight": 620,
        "decorations": false,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset:; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["bymevpn"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": [
      "../vendor/runtime/windows-x64/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "ByMeVPN for Windows",
    "longDescription": "ByMeVPN desktop client for Windows",
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}
